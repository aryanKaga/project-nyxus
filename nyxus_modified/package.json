{
  "name": "nyxus-coding-agent-replica",
  "displayName": "Nyxus",
  "description": "Nyxus - Autonomous Coding Agent",
  "version": "0.0.7",
  "publisher": "aryanKaga",
  "repository": {
    "type": "git",
    "url": "https://github.com/aryanKaga/project-nyxus"
  },
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nyxusReplica",
          "title": "Nyxus",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "nyxusReplica": [
        {
          "id": "nyxusReplica.sidebar",
          "name": "Nyxus Chat",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "nyxusReplica.sayHi",
        "title": "Nyxus Test: Say Hi"
      },
      {
        "command": "nyxusReplica.openSidebar",
        "title": "Open Nyxus Sidebar"
      },
      {
        "command": "nyxusReplica.openSettings",
        "title": "Open Nyxus Settings"
      },
      {
        "command": "nyxusReplica.setApiKey",
        "title": "Nyxus: Set API Key"
      },
      {
        "command": "nyxusReplica.openNativeSettings",
        "title": "Nyxus: Open Settings"
      }
    ],
    "configuration": {
      "title": "Nyxus",
      "properties": {
        "nyxusReplica.url": {
          "type": "string",
          "default": "http://54.79.152.236",
          "scope": "machine",
          "description": "Base URL of the Nyxus server used for chat, workspace uploads, and workspace ID requests."
        },
        "nyxusReplica.userId": {
          "type": "string",
          "default": "123",
          "scope": "machine",
          "description": "User ID sent with Nyxus workspace requests."
        },
        "nyxusReplica.apiKey": {
          "type": "string",
          "default": "abc@123",
          "scope": "machine",
          "description": "API Key used to authenticate Nyxus requests."
        },
        "nyxusReplica.requestTimeout": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 600000,
          "scope": "application",
          "description": "Maximum time in milliseconds to wait for a Nyxus server acknowledgement."
        },
        "nyxusReplica.uploadTimeout": {
          "type": "number",
          "default": 300000,
          "minimum": 10000,
          "maximum": 600000,
          "scope": "application",
          "description": "Maximum time in milliseconds to wait for Git workspace transfer, unpacking, and database saving (default: 300,000ms / 5 minutes)."
        },
        "nyxusReplica.enableWorkspaceSync": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Automatically prepare and synchronize the open workspace when the Nyxus sidebar opens."
        },
        "nyxusReplica.autoReuseWorkspaceId": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Reuse the locally saved workspace ID for this folder when synchronizing workspace data."
        },
        "nyxusReplica.workspaceSyncBehavior": {
          "type": "string",
          "enum": ["onSidebarOpen", "disabled"],
          "enumDescriptions": ["Synchronize when the Nyxus sidebar opens.", "Do not synchronize workspace data automatically."],
          "default": "onSidebarOpen",
          "scope": "resource",
          "description": "When Nyxus prepares and sends workspace data."
        },
        "nyxusReplica.connectionTimeout": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "maximum": 120000,
          "scope": "application",
          "description": "Maximum time in milliseconds to establish a Nyxus Socket.IO connection."
        },
        "nyxusReplica.reconnectionDelay": {
          "type": "number",
          "default": 1000,
          "minimum": 100,
          "maximum": 60000,
          "scope": "application",
          "description": "Initial delay in milliseconds before Socket.IO retries a failed connection."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:webview",
    "build:webview": "npm --prefix webview-ui run build",
    "package": "vsce package",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test test/unit/*.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "vsce": "^1.97.0"
  },
  "directories": {
    "test": "test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "globals": "^17.6.0",
    "socket.io-client": "^4.8.3",
    "web-tree-sitter": "^0.26.9"
  }
}
